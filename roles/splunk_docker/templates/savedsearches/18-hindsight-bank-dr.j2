{# ---------------------------------------------------------------------------
   Hindsight bank-DR alerting (index=hindsight, sourcetype=hindsight:app --
   tofu-proxmox modules/proxmox-stack/constants-ai-log.tf ai_log_index_map,
   hindsight_docker entry -- the single source of truth for that routing).

   Producer: ansible-proxmox-ai roles/hindsight_bank_dr (hindsight-bank-export
   .service nightly, hindsight-bank-dr-drill.service weekly). Each unit emits
   exactly one structured JSON line to stdout -> journald -> the same
   rsyslog/Cribl route the hindsight container's own logs already use, so no
   new log pipeline exists for these two events. Field shapes, verified
   against the rendered .sh.j2 templates at the time this alert was written:

     hindsight_bank_export: event, result (pass|fail), banks_total, exported,
       failed, failed_banks, duration_seconds, bucket, date
     hindsight_dr_drill: event, result (pass|fail), bank, scratch_bank,
       import_seconds, recall_seconds, nodes_restored, documents_restored,
       error, run_id

   Four stanzas, not two: "page on fail" and "page on no pass in window" are
   different alert shapes (presence-of-bad-row vs absence-of-good-row) with
   different SPL, and the two events don't share a field schema, so folding
   them into fewer stanzas (like hermes_failure_classes' one-search/many-class
   shape) would need per-event branching for every field in the table below
   with no reduction in actual logic.

   rex + spath (not INDEXED_EXTRACTIONS): no props.conf stanza anywhere in
   this repo declares JSON extraction for `hindsight:app`, so the printed
   JSON line is unparsed inside `_raw` at search time. Same idiom as
   14-openbao.j2, generalized: pull the first `{...}` blob out of `_raw`
   (covers a bare JSON line and one with a leading syslog tag alike) rather
   than depend on any particular tag text this route may or may not add.

   INDEX TIME, NOT EVENT TIME: `_index_earliest`/`_index_latest`, not
   `earliest=`/`latest=` against `_time` -- the latter is a well-known silent
   no-op as a bare search term, and more importantly a systemd unit's own
   clock is exactly the kind of thing DR alerting must not blindly trust.
--------------------------------------------------------------------------- #}
[hindsight_bank_export_failed]
description = Alerts on any hindsight_bank_export result=fail event in index=hindsight (ansible-proxmox-ai roles/hindsight_bank_dr, hindsight-bank-export.service) -- an enumerated bank failed to export or upload, or fewer banks uploaded than were enumerated (see the script's own EXPORTED==BANK_TOTAL gate).
search = index=hindsight sourcetype=hindsight:app _index_earliest=-15m _index_latest=now | rex field=_raw "(?<j>\{.*\})" | spath input=j | where event="hindsight_bank_export" AND result="fail" | table _time host result banks_total exported failed failed_banks duration_seconds bucket date
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 240m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[hindsight_dr_drill_failed]
description = Alerts on any hindsight_dr_drill result=fail event in index=hindsight (ansible-proxmox-ai roles/hindsight_bank_dr, hindsight-bank-dr-drill.service) -- the restore drill failed to download/import the latest export, the restored scratch bank held zero memory units, or the advisory recall check errored.
search = index=hindsight sourcetype=hindsight:app _index_earliest=-15m _index_latest=now | rex field=_raw "(?<j>\{.*\})" | spath input=j | where event="hindsight_dr_drill" AND result="fail" | table _time host result bank scratch_bank import_seconds recall_seconds nodes_restored documents_restored error run_id
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 240m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

{# Absence detectors: a `stats ... AND result="pass"` filter over a window
   with no matching event returns ZERO rows, not a row with a null last_pass
   -- the same blind spot 12-ansible-pipeline-staleness.j2 guards with
   appendpipe, needed here for the same reason: an alert whose whole point is
   "nothing good happened" must not go quiet itself when NOTHING happened at
   all (host down, unit dead, export/Cribl route broken). This is also what
   catches the host itself going dark, which a systemd OnFailure= hook on the
   unit could never see -- a dead host never runs OnFailure= either. #}
[hindsight_bank_export_no_pass]
description = Alerts when no hindsight_bank_export result=pass event has landed in index=hindsight within the last 26 hours. The export unit is nightly; 26h covers one run's full schedule plus slack without paging on ordinary jitter. Also fires if the run failed (already paged by hindsight_bank_export_failed) or if the host/unit/log route is dark entirely.
search = index=hindsight sourcetype=hindsight:app _index_earliest=-26h _index_latest=now | rex field=_raw "(?<j>\{.*\})" | spath input=j | where event="hindsight_bank_export" AND result="pass" | stats max(_time) as last_pass | appendpipe [ stats count as _rows | where _rows == 0 | eval last_pass = 0 | fields - _rows ] | eval hours_since_pass = round((now() - last_pass) / 3600, 1) | where hours_since_pass > 26
dispatch.earliest_time = -26h
dispatch.latest_time = now
cron_schedule = */30 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 360m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[hindsight_dr_drill_no_pass]
description = Alerts when no hindsight_dr_drill result=pass event has landed in index=hindsight within the last 8 days. The drill unit is weekly; 8 days covers one run's full schedule plus slack without paging on ordinary jitter. Also fires if the run failed (already paged by hindsight_dr_drill_failed) or if the host/unit/log route is dark entirely.
search = index=hindsight sourcetype=hindsight:app _index_earliest=-8d _index_latest=now | rex field=_raw "(?<j>\{.*\})" | spath input=j | where event="hindsight_dr_drill" AND result="pass" | stats max(_time) as last_pass | appendpipe [ stats count as _rows | where _rows == 0 | eval last_pass = 0 | fields - _rows ] | eval days_since_pass = round((now() - last_pass) / 86400, 1) | where days_since_pass > 8
dispatch.earliest_time = -8d
dispatch.latest_time = now
cron_schedule = 0 */2 * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 720m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
