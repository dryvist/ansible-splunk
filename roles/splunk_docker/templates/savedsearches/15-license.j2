{# ---------------------------------------------------------------------------
   License expiry. The converge only refuses an already-expired license, so
   the daily warning lives here, where it is delivered like every other alert.
   The stock free/forwarder entries never expire and are excluded by type.
--------------------------------------------------------------------------- #}
[splunk_license_expiring]
description = Alerts daily when the installed Splunk license expires within 30 days or has already expired. On expiry every search fails with a litsearch error naming the license.
search = | rest /services/licenser/licenses | where type!="free" AND type!="forwarder" | eval days_left=round((expiration_time - now()) / 86400) | where days_left < 30 | table label type status days_left
dispatch.earliest_time = -1m
dispatch.latest_time = now
cron_schedule = 17 9 * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 20h
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
