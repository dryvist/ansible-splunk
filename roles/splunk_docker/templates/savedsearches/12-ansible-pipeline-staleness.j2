{# ---------------------------------------------------------------------------
   Pipeline-staleness detectors (index=ansible).

   These watch the chain desired state -> published inventory artifact ->
   converged host. Every link in it holds silently: a change that is merged but
   never applied, or applied but never converged, produces no event, no log line
   and no non-zero exit anywhere, so the symptom surfaces far from the cause.

   Producer: the ansible-proxmox-apps converge_telemetry callback plugin.
   Design + SPL rationale: that repo docs/CONVERGE_FRESHNESS.md.

   None of these use tstats. An accelerated/indexed-field search path can
   silently return nothing, and an alert whose entire purpose is to detect
   ABSENCE must never be built on one.
--------------------------------------------------------------------------- #}
[ansible_stale_converge]
{{ alert_delivery -}}
description = A host reported a successful converge at some point in the last 30 days but not in the last 7. Configuration drift on it is now unmanaged: a merged role change reaches a host only when that host is converged, so an un-converged host keeps serving whatever it last rendered, indefinitely and without complaint.
# `stats ... BY host` over zero matching converge events (index=ansible dead:
# HEC token expired, the callback plugin broken, or the index itself
# missing) returns ZERO rows -- not a row with a null last_converge -- so a
# bare eval/where guard never runs during total silence, the same blind spot
# PR #460 closed for the tstats-based detectors elsewhere in this file.
# appendpipe synthesizes a sentinel row when the stats result set is empty:
# an ungrouped aggregate (stats count) always emits exactly one row, even
# over zero input rows.
search = index=ansible sourcetype="ansible:converge" status=success earliest=-30d | stats max(_time) AS last_converge, latest(playbook) AS playbook, latest(git_sha) AS git_sha BY host | appendpipe [ stats count as _rows | where _rows == 0 | eval host = "(no hosts reporting)", last_converge = 0 | fields - _rows ] | eval age_days = round((now() - last_converge) / 86400, 1) | where age_days > 7 | eval last_converge = strftime(last_converge, "%Y-%m-%d %H:%M:%S") | sort - age_days | table host, last_converge, age_days, playbook, git_sha
# The 30-day look-back bounds the search. A host quiet for longer than that
# drops out of this alert and is caught by ansible_orphan_host instead.
dispatch.earliest_time = -30d@d
dispatch.latest_time = now
cron_schedule = 17 * * * *
enableSched = 1
is_visible = 1
# ponytail: index=ansible has zero events ever, so the sentinel "(no hosts
# reporting)" row will satisfy this where clause on every cron cycle --
# suppression throttles repeat NOTIFICATIONS but the underlying condition
# never clears. Expect a false-alarm loop, not real staleness, until the
# converge_telemetry producer chain actually ships events.
disabled = 0
alert.severity = 4
alert.digest_mode = 1
alert.suppress = 1
alert.suppress.period = 12h
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[ansible_orphan_host]
{{ alert_delivery -}}
description = A host is present in the Ansible inventory roster but has no successful converge event at all in the last 30 days. It is provisioned and entirely unmanaged.
# Same zero-row blind spot as ansible_stale_converge above: `stats ... BY
# host` over a fully-silent index=ansible (roster AND converge producers both
# dark) returns ZERO rows, so this alert -- whose entire point is catching
# "nothing is being tracked" -- would itself go silent in exactly that case.
# The sentinel row sets last_in_inventory = now() (recent) and leaves
# last_converge unset (null), satisfying the where clause below.
search = index=ansible (sourcetype="ansible:converge:roster" OR (sourcetype="ansible:converge" status=success)) earliest=-30d | eval roster_time = if(sourcetype=="ansible:converge:roster", _time, null()), converge_time = if(sourcetype=="ansible:converge", _time, null()) | stats max(roster_time) AS last_in_inventory, max(converge_time) AS last_converge BY host | appendpipe [ stats count as _rows | where _rows == 0 | eval host = "(no hosts reporting)", last_in_inventory = now() | fields - _rows ] | where isnotnull(last_in_inventory) AND last_in_inventory > relative_time(now(), "-7d") AND isnull(last_converge) | eval last_in_inventory = strftime(last_in_inventory, "%Y-%m-%d %H:%M:%S") | table host, last_in_inventory
# The last_in_inventory > -7d clause scopes this to hosts CURRENTLY in
# inventory, so a decommissioned guest ages out instead of alerting forever.
# No join and no subsearch, so neither the subsearch result cap nor an
# autofinalize can silently truncate the answer.
dispatch.earliest_time = -30d@d
dispatch.latest_time = now
cron_schedule = 40 6 * * *
enableSched = 1
is_visible = 1
# ponytail: index=ansible has zero events ever, so the sentinel "(no hosts
# reporting)" row will satisfy this where clause on every cron cycle --
# suppression throttles repeat NOTIFICATIONS but the underlying condition
# never clears. Expect a false-alarm loop, not real staleness, until the
# converge_telemetry producer chain actually ships events.
disabled = 0
alert.severity = 4
alert.digest_mode = 1
alert.suppress = 1
alert.suppress.period = 24h
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[ansible_apply_owed]
{{ alert_delivery -}}
description = Desired state has been edited but no apply has republished the inventory artifact from it, so every converge is consuming an artifact that contradicts desired state. Applying only re-renders the artifact and converging only consumes whatever the artifact currently says, so a converge run in this state produces a confidently wrong result rather than an error. Fires on the fingerprint the converge itself reports, not on a clock, so a desired-state edit that happens to change nothing downstream cannot false-fire.
# Same zero-row blind spot as the two detectors above, but NOT a pure
# elapsed-time check: the drift filter (desired_state_current) moves from the
# base search into the where clause below the per-host stats, because
# filtering on it in the base search made "the fleet has zero drift" and
# "index=ansible is completely dead" produce the identical zero-row result --
# a guard could not tell those apart, and a guard on the narrow base filter
# would fire on every dispatch once the fleet simply has no drift, rather
# than only when the producer itself has gone dark. Aggregating over every
# converge event (not just desired_state_current=false ones) and filtering
# afterward keeps that distinction: the sentinel row carries
# desired_state_current = "false" so it survives the where clause precisely
# when it represents "no data at all", not "no drift". Still inert until the
# producer chain publishes the fingerprint -- latest(desired_state_current)
# is null on every real row until then, so only the sentinel (on a fully
# silent index) or an actual drifted host can survive the where clause.
search = index=ansible sourcetype="ansible:converge" earliest=-7d | stats max(_time) AS last_seen, latest(desired_state_current) AS desired_state_current, latest(desired_state_published) AS published, latest(desired_state_live) AS live BY host | appendpipe [ stats count as _rows | where _rows == 0 | eval host = "(no hosts reporting)", last_seen = 0, desired_state_current = "false" | fields - _rows ] | where desired_state_current=="false" | eval last_seen = strftime(last_seen, "%Y-%m-%d %H:%M:%S") | table host, last_seen, published, live
dispatch.earliest_time = -7d@d
dispatch.latest_time = now
cron_schedule = 25 * * * *
enableSched = 1
is_visible = 1
# ponytail: index=ansible has zero events ever, so the sentinel "(no hosts
# reporting)" row will satisfy this where clause on every cron cycle --
# suppression throttles repeat NOTIFICATIONS but the underlying condition
# never clears. Expect a false-alarm loop, not real staleness, until the
# converge_telemetry producer chain actually ships events.
disabled = 0
alert.severity = 4
alert.digest_mode = 1
alert.suppress = 1
alert.suppress.period = 12h
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
