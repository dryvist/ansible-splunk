{# The same figure also exists as a recording rule in the metrics store, which is the KPI definition; this report reads the same raw utilization from the log platform. #}
[gpu_utilization_report]
{{ status_delivery -}}
description = Every 30 minutes, a non-paging GPU utilization report on the hub's status topic: per host, the 4-hour average utilization as a whole percent, a 12-hour hourly sparkline (one point per full hour over the last 12 hours, oldest first) and the change over the last hour as an up, down or flat arrow; the Mac active ratio is scaled to percent. One line per host sorted by host name, marked green, yellow or red on the 4-hour figure. Hosts come from the metric data, never from a list in this file.
search = | mstats avg(node_gpu_utilization_gpu_percent_all) as nvidia avg(macmon_gpu_active_ratio) as mac WHERE index=* earliest=-12h@h latest=@h span=1h by host | eval host = mvindex(split(replace(host, ":[0-9]+$", ""), "."), 0) | eval u = coalesce(nvidia, mac * 100) | where isnotnull(u) | stats avg(u) as u by _time host | xyseries _time host u | makecontinuous _time span=1h | fillnull value=0 | untable _time host u | sort 0 host _time | eval ch = mvindex(split("▁,▂,▃,▄,▅,▆,▇,█", ","), min(floor(u / 12.5), 7)) | stats list(ch) as chars list(u) as us by host | eval spark = mvjoin(chars, "") | eval n1 = coalesce(tonumber(mvindex(us, -1)), 0), n2 = coalesce(tonumber(mvindex(us, -2)), 0) | eval n3 = coalesce(tonumber(mvindex(us, -3)), 0), n4 = coalesce(tonumber(mvindex(us, -4)), 0) | eval pct_4h = round((n1 + n2 + n3 + n4) / 4, 0) | eval d = round(n1, 0) - round(n2, 0) | eval arrow = case(d > 0, "↑" . d, d < 0, "↓" . abs(d), true(), "→") | eval mark = case(pct_4h >= 50, "🟢", pct_4h >= 25, "🟡", true(), "🔴") | eval line = mark . " " . host . " " . pct_4h . "% " . spark . " " . arrow | sort 0 host | stats list(line) as lines | where isnotnull(lines) | eval message = "GPU utilization" . urldecode("%0A") . mvjoin(lines, urldecode("%0A")) | table message
dispatch.earliest_time = -12h
dispatch.latest_time = now
cron_schedule = */30 * * * *
allow_skew = 5m
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 1
alert.track = 0
counttype = number of events
relation = greater than
quantity = 0
