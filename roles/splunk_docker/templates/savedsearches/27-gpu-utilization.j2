{# The token-utilization KPI is defined by a recording rule in the metrics store; this report computes the same ratio from the same serving counters in the log platform. #}
{# An empty map renders null(), so every lane is dropped and nothing is posted. #}
{% set max_map = splunk_docker_llm_token_max_tps | default({}) %}
{% set max_case %}{% if max_map %}case({% for lane, tps in max_map | dictsort %}accelerator=="{{ lane }}", {{ tps }}{{ ", " if not loop.last }}{% endfor %}){% else %}null(){% endif %}{% endset %}
[gpu_utilization_report]
{{ status_delivery -}}
description = Every 30 minutes, a non-paging local LLM utilization report on the hub's status topic. Per serving lane, three lines. Token utilization: generated tokens per second over the lane's measured maximum, as the 4-hour average in whole percent with both figures shown, a 12-hour hourly sparkline (oldest first) and the change over the last hour as an arrow; green from 90 percent, yellow from 45. Slot duty: the average number of requests running over the lane's declared serving slots for the last 4 hours, with both figures shown; green from 50 percent, yellow from 25. Prompt cache rate: cached prompt tokens over received prompt tokens for the last 4 hours; green from 80 percent, yellow from 60. Lanes come from the metric data and the maximum map, never from a host list in this file. The driver's GPU busy percentage is not used: it reads high whenever any request runs and says nothing about throughput.
search = | mstats rate_sum(vllm:generation_tokens_total) as gen WHERE index=* earliest=-12h@h latest=@h span=1h by accelerator | eval max = {{ max_case }} | where isnotnull(max) | eval u = 100 * gen / max | xyseries _time accelerator u | makecontinuous _time span=1h | fillnull value=0 | untable _time accelerator u | sort 0 accelerator _time | eval ch = mvindex(split("▁,▂,▃,▄,▅,▆,▇,█", ","), min(floor(u / 12.5), 7)) | stats list(ch) as chars list(u) as us by accelerator | eval spark = mvjoin(chars, "") | eval n1 = coalesce(tonumber(mvindex(us, -1)), 0), n2 = coalesce(tonumber(mvindex(us, -2)), 0) | eval n3 = coalesce(tonumber(mvindex(us, -3)), 0), n4 = coalesce(tonumber(mvindex(us, -4)), 0) | eval pct_4h = round((n1 + n2 + n3 + n4) / 4, 0) | eval max = {{ max_case }} | eval tps = round(pct_4h * max / 100, 0) | eval d = round(n1, 0) - round(n2, 0) | eval arrow = case(d > 0, "↑" . d, d < 0, "↓" . abs(d), true(), "→") | join type=left accelerator [| mstats rate_sum(vllm:prompt_tokens_total) as p rate_sum(vllm:prompt_tokens_cached_total) as c WHERE index=* earliest=-4h@h latest=@h by accelerator | eval cache = round(100 * c / p, 0) | fields accelerator cache] | join type=left accelerator [| mstats avg(vllm:num_requests_running) as busy WHERE index=* earliest=-4h@h latest=@h by accelerator | join type=left accelerator [| mstats max(llm_serving_declared_slots) as slots WHERE index=* engine=vllm earliest=-4h@h latest=@h by accelerator] | eval duty = round(100 * busy / slots, 0), busy = round(busy, 1), slots = round(slots, 0) | fields accelerator duty busy slots] | eval mark = case(pct_4h >= 90, "🟢", pct_4h >= 45, "🟡", true(), "🔴") | eval cmark = case(isnull(cache), "🔴", cache >= 80, "🟢", cache >= 60, "🟡", true(), "🔴") | eval dmark = case(isnull(duty), "🔴", duty >= 50, "🟢", duty >= 25, "🟡", true(), "🔴") | eval line = mark . " " . accelerator . " tokens " . pct_4h . "% (" . tps . " of " . max . " tok/s) " . spark . " " . arrow . urldecode("%0A") . dmark . " " . accelerator . " slot duty " . coalesce(duty . "% (" . busy . " of " . slots . " slots busy)", "unmeasured") . urldecode("%0A") . cmark . " " . accelerator . " prompt cache " . coalesce(cache . "%", "unmeasured") | sort 0 accelerator | stats list(line) as lines | where isnotnull(lines) | eval message = "Local LLM utilization, 4 h" . urldecode("%0A") . mvjoin(lines, urldecode("%0A")) | table message
dispatch.earliest_time = -12h
dispatch.latest_time = now
cron_schedule = */30 * * * *
allow_skew = 5m
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 1
alert.track = 0
counttype = number of events
relation = greater than
quantity = 0
