{# ---------------------------------------------------------------------------
   Proxmox HA fencing and recovery errors from syslog.

   The role does not manage syslog props, so extract the program name inline.
--------------------------------------------------------------------------- #}
[pve_ha_fence]
{{ alert_delivery -}}
description = Alerts on Proxmox HA fencing, watchdog activity, or a node reported lost.
search = (index=os OR index=os_proxmox) host=pve-* ("fenc*" OR "state changed from 'online' => 'unknown'" OR "watchdog expired" OR "node lost") | rex field=_raw "(?<appname>pve-ha-crm|pve-ha-lrm|watchdog-mux)(?:\[\d+\])?:" | where in(appname, "pve-ha-crm", "pve-ha-lrm", "watchdog-mux") | stats count by host
dispatch.earliest_time = -10m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 5
alert.suppress = 1
alert.suppress.period = 30m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[pve_ha_recovery_error]
{{ alert_delivery -}}
description = Alerts on Proxmox HA recovery policy or error-state messages.
search = (index=os OR index=os_proxmox) host=pve-* ("recovery policy" OR "no recovery node" OR "error state") | rex field=_raw "(?<appname>pve-ha-crm)(?:\[\d+\])?:" | where appname="pve-ha-crm" | stats count by host
dispatch.earliest_time = -10m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 5
alert.suppress = 1
alert.suppress.period = 30m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
