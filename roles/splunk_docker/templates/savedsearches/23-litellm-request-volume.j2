{# Compare each completed hour with the same hour's rolling baseline. #}
[litellm_request_volume_drop]
{{ alert_delivery -}}
description = Alerts when LiteLLM request volume falls below the configured fraction of its rolling same-hour baseline.
search = index=llm sourcetype="litellm:proxy" "llm_request" | spath input=message path=event output=event | where event="llm_request" | timechart span=1h count as requests | makecontinuous _time span=1h | fillnull value=0 requests | addinfo | eval hour=strftime(_time, "%H"), target_hour=relative_time(info_max_time, "-1h@h") | eval baseline_requests=if(_time >= relative_time(target_hour, "-{{ splunk_docker_litellm_request_baseline_days }}d") AND _time < target_hour, requests, null()) | eventstats median(baseline_requests) as baseline by hour | where _time == target_hour AND isnotnull(baseline) AND baseline >= {{ splunk_docker_litellm_request_min_baseline_per_hour }} AND requests < baseline * {{ splunk_docker_litellm_request_drop_ratio }} | table _time requests baseline
dispatch.earliest_time = -{{ splunk_docker_litellm_request_dispatch_days }}d@h
dispatch.latest_time = now
cron_schedule = 5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
