[mac_process_lifecycle_silence]
{{ alert_delivery -}}
# tstats returns ZERO rows (not a row with a null last_seen) when nothing in
# the whole lookback window matches, so the appendpipe below synthesizes the
# missing row and lets the where clause fire during full silence.
description = Alerts when no macOS process-lifecycle events have been indexed in index=os for more than 15 minutes.
search = | tstats latest(_time) as last_seen WHERE index=os sourcetype=macos:process:lifecycle | appendpipe [ stats count as _rows | where _rows == 0 | eval last_seen = 0 | fields - _rows ] | eval minutes_silent = (now() - coalesce(last_seen, 0)) / 60 | where minutes_silent > 15
dispatch.earliest_time = -24h
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 24h
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
