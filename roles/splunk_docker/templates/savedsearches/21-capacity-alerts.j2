{# Pool, node-swap and ClickHouse filesystem capacity detectors. #}
[pve_zpool_fill]
{{ alert_delivery -}}
description = Fires when a PVE node reports an imported ZFS pool at 85 percent capacity or higher.
search = index=os_proxmox sourcetype=pve:health \
  | rex "zpool_cap_max=(?<zpool_cap_max>-?\d+)" \
  | rex "zpool_cap_pool=(?<zpool_cap_pool>\S+)" \
  | stats latest(zpool_cap_max) as zpool_cap_max latest(zpool_cap_pool) as zpool_cap_pool by host \
  | where zpool_cap_max >= 85
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 6h
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[pve_swap_active]
{{ alert_delivery -}}
description = Fires when a PVE node's latest swap usage exceeds 2 GiB.
search = | mstats latest(node_memory_SwapTotal_bytes) as t latest(node_memory_SwapFree_bytes) as f WHERE index=host_metrics host=pve-* span=5m BY host \
  | stats latest(t) as t latest(f) as f by host \
  | eval used=t-f \
  | where used > 2147483648
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 6h
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[clickhouse_disk_fill]
{{ alert_delivery -}}
description = Fires when a ClickHouse filesystem mount reaches 85 percent used capacity.
search = | mstats latest(node_filesystem_avail_bytes) as a latest(node_filesystem_size_bytes) as s WHERE index=host_metrics host=clickhouse fstype!=tmpfs span=5m BY host mountpoint \
  | eval pct_used=round((1-a/s)*100,1) \
  | where pct_used >= 85
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 5
alert.suppress = 1
alert.suppress.period = 6h
alert.suppress.fields = host,mountpoint
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
