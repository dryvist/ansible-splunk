[llm_serving_memory_headroom]
description = Warns BEFORE the serving host's memory reaches the Metal cache-clear trip (~85% of a 128 GB host = ~109 GB). Rides the mlx:metrics system-metrics feed (node_memory_used_percent) so it works even while the vllm-mlx log input is broken (nix-darwin#1623). Sustained-average over 5 minutes so a single load spike (a model swap-in) does not page anyone.
search = index=llm sourcetype=mlx:metrics node_memory_used_percent=* | stats avg(node_memory_used_percent) as used_pct by host | where used_pct > 85
dispatch.earliest_time = -5m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[llm_metal_resource_limit_detector]
description = Fires on any MLX Metal buffer-count ceiling error ("[metal::malloc] Resource limit (499000) exceeded") reaching the llm index — the mid-stream-abort failure mode the 2026-07 serving fixes (buffer-cache cap + paged-block sizing) are meant to make impossible. Zero-noise by design: any single event is a regression worth investigating. Depends on the vllm-mlx log input (nix-darwin#1623); inert until that delivers.
search = index=llm "Resource limit (499000)"
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 5
alert.suppress = 1
alert.suppress.period = 60m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[llm_night_rank_error_detector]
description = Fires on night-cluster rank/link-watcher errors (JACCL init failures, rank crashes, distributed aborts) in the night logs shipped by the serving hosts' in_night_logs input. Zero-noise by design: the night fabric is supposed to converge silently, so any error line is worth a look before the next plug night.
search = index=llm source=*mlx-night* (error OR Traceback OR "night-link: rank not running")
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */15 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[llm_night_idle_cluster_detector]
description = "Night mode active but unused": the night rank has been up (rank log activity in the last hour) yet the gate's night endpoint saw zero completions in 30 minutes. Cluster capacity is burning memory on both Macs while Hermes/router traffic is not reaching it — usually a router flag (ai_night_brain_enabled) or fallback chain issue.
search = index=llm (source=*mlx-night*night-rank* OR source=*night-access*) | stats count(eval(if(match(source, "night-rank"), 1, null()))) as rank_activity, count(eval(if(match(source, "night-access") AND _time >= relative_time(now(), "-30m@m"), 1, null()))) as night_requests | where rank_activity > 0 AND night_requests = 0
dispatch.earliest_time = -60m
dispatch.latest_time = now
cron_schedule = */30 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 3
alert.suppress = 1
alert.suppress.period = 120m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0


{# ---------------------------------------------------------------------------
   PENDING DATA, all three below: they read sourcetype=llm-serving-share,
   the router's structured per-request line
   (llm_router_serving_share_syslog_identifier in ansible-proxmox-ai's
   llm_router role defaults). That route does not ship yet -- it lands with
   feature/llm-router-syslog in ansible-proxmox-ai, a separate PR -- so these
   three searches return zero rows until then, same as
   llm_metal_resource_limit_detector above ("inert until that delivers").
   Field names (caller_429_rate, status, duration_ms) are taken from the W6
   design doc's own wording for these signals, not yet confirmed against a
   live JSON sample; reconcile against the real schema once
   feature/llm-router-syslog lands.
--------------------------------------------------------------------------- #}
[llm_caller_429_rate]
description = Alerts when the LiteLLM router's own per-request serving-share line reports a sustained 429 rate to callers over the last hour. Rides the field the router already emits rather than recomputing it from raw status codes. PENDING DATA (see template header): inert until feature/llm-router-syslog (ansible-proxmox-ai) ships sourcetype=llm-serving-share into index=llm.
search = index=llm sourcetype=llm-serving-share caller_429_rate=* _index_earliest=-60m _index_latest=now | stats avg(caller_429_rate) as avg_429_rate by host | where avg_429_rate > 0.2
dispatch.earliest_time = -60m
dispatch.latest_time = now
cron_schedule = */15 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[llm_leaked_inflight_counter]
description = Vikunja 1544: a leaked in-flight-request counter rejects callers with 429 in under 10ms, before the backend could have actually checked capacity -- a real capacity-based 429 takes measurably longer. Deliberately NOT a plain 429-volume alert (design doc: that "is ordinary contention and it is what made the watchdog page hourly") -- the sub-10ms latency is the unambiguous leak signature on its own. PENDING DATA (see template header): inert until feature/llm-router-syslog (ansible-proxmox-ai) ships sourcetype=llm-serving-share into index=llm.
search = index=llm sourcetype=llm-serving-share status=429 duration_ms<10 _index_earliest=-15m _index_latest=now | stats count by host | where count > 5
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

{# ---------------------------------------------------------------------------
   Watchdog transitions. hermes-brain-watchdog.sh (ansible-proxmox-ai) already
   emits `probe_state up|busy|down` and posts the two exact messages matched
   below on transition (roles/hermes_agent/templates/hermes-brain-watchdog.sh.j2
   ::alert() and ::maybe_escalate_sustained_flap()) -- the script's own
   debounce, flap coalescing and sustained-flap escalation already do the hard
   part; this must not add a second, differently-tuned debounce on top, so it
   alerts on any single occurrence of either message rather than aggregating.

   ROUTING CAVEAT: grouped here under index=llm per this PR's assignment
   (same "once feature/llm-router-syslog lands" pending-data footing as the
   two searches above), but the watchdog runs on the Hermes guest, not the
   router, and this repo's OWN 05-hermes-delivery-slo.j2 records that
   host=hermes-agent syslog currently lands in index=os_ai, not index=llm.
   If the watchdog's route is not part of feature/llm-router-syslog's
   change, this search needs repointing to index=os_ai host=hermes-agent
   once that lands -- flagging rather than guessing which is intended.
--------------------------------------------------------------------------- #}
[llm_watchdog_down]
description = Fires on either hermes-brain-watchdog.sh transition message reaching index=llm -- "brain unreachable" (down) or "brain UNSTABLE ... still flapping" (sustained flap). The script already debounces and coalesces flaps itself; this adds no second debounce, only a downstream alert on its own output. PENDING DATA / ROUTING CAVEAT (see template header): inert until the watchdog's syslog route reaches this index, which may not be the same change as feature/llm-router-syslog.
search = index=llm _index_earliest=-15m _index_latest=now ("brain unreachable" OR "brain UNSTABLE") | stats count by host | where count > 0
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 5
alert.suppress = 1
alert.suppress.period = 30m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
