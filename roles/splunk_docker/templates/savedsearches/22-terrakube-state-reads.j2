{# State-version API request failures in the proxy access logs. #}
[terrakube_state_version_5xx]
{{ alert_delivery -}}
description = Alerts on HTTP 5xx responses from the state-version API endpoints.
search = index=proxy sourcetype=traefik:syslog ("current-state-version" OR "state-version") | eval status_5xx=if(match(message, "(?<![0-9])5[0-9][0-9](?![0-9])"), 1, 0) | where status_5xx=1 | stats count as status_5xx by host | where status_5xx >= {{ splunk_docker_terrakube_state_5xx_min_events }}
dispatch.earliest_time = -{{ splunk_docker_terrakube_state_5xx_lookback_minutes }}m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
