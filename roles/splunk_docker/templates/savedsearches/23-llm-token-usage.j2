{# ---------------------------------------------------------------------------
   Native daily LiteLLM token usage by registry tier, billing class, model,
   provider, and token type. Cribl's existing prometheus_rw path sends these
   router counters to Splunk. cacheRead is removed from input before rows are
   emitted, so the token types add to the request total without double count.
--------------------------------------------------------------------------- #}
[llm_token_usage_by_tier]
description = Daily LiteLLM tokens by registry tier, billing class, model, provider and token type. Input excludes cacheRead, which is reported separately.
search = | mstats rate_sum(litellm_input_tokens_metric_total) as input_rate rate_sum(litellm_output_tokens_metric_total) as output_rate rate_sum(litellm_input_cached_tokens_metric_total) as cache_read_rate WHERE index=llm_metrics sourcetype=prometheus:metrics job=llm_router earliest=-30d BY model api_provider tag_telemetry_tier_large tag_telemetry_tier_light tag_telemetry_tier_vllm tag_telemetry_tier_gpu tag_telemetry_tier_hermes_local tag_telemetry_tier_cpu_moe tag_telemetry_tier_cpu_9b tag_telemetry_billing_class_local tag_telemetry_billing_class_subscription tag_telemetry_billing_class_free tag_telemetry_billing_class_paid span=1d | eval input_rate=coalesce(input_rate, 0), output_rate=coalesce(output_rate, 0), cache_read_rate=coalesce(cache_read_rate, 0) | eval tier=case(tag_telemetry_tier_large="true", "large", tag_telemetry_tier_light="true", "light", tag_telemetry_tier_vllm="true", "vllm", tag_telemetry_tier_gpu="true", "gpu", tag_telemetry_tier_hermes_local="true", "hermes-local", tag_telemetry_tier_cpu_moe="true", "cpu-moe", tag_telemetry_tier_cpu_9b="true", "cpu-9b"), billing_class=case(tag_telemetry_billing_class_local="true", "local", tag_telemetry_billing_class_subscription="true", "subscription", tag_telemetry_billing_class_free="true", "free", tag_telemetry_billing_class_paid="true", "paid"), cache_read_tokens=round(cache_read_rate*86400, 0), input_tokens=round(input_rate*86400, 0)-round(cache_read_rate*86400, 0), output_tokens=round(output_rate*86400, 0), token_type="input", tokens=input_tokens | appendpipe [ eval token_type="output", tokens=output_tokens ] | appendpipe [ where token_type="input" | eval token_type="cacheRead", tokens=cache_read_tokens ] | where isnotnull(tier) AND isnotnull(billing_class) | table _time tier billing_class model api_provider token_type tokens | sort 0 _time tier billing_class model api_provider token_type
is_visible = 1
disabled = 0
enableSched = 0
