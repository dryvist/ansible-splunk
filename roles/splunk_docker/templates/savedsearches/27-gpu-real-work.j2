{# Router request logs are JSON after the syslog prefix. The reports topic is
   informational and keeps daily and weekly usage out of the alert channel. #}
[gpu_real_work_daily]
{{ report_delivery -}}
description = Daily LiteLLM GPU usage by accelerator and caller, with request, generated-token and prompt-token totals.
search = index=llm sourcetype="litellm:proxy" | rex field=_raw "litellm\[\d+\]: (?<j>\{.*)" | spath input=j | fillnull value="unattributed" key_alias api_base | fillnull value=0 completion_tokens prompt_tokens | eval accelerator=case(match(api_base, "(?i)blackwell"), "RTX 6000", match(api_base, "(?i)ada-lovelace"), "RTX 4080", match(api_base, "(?i)mac"), "Mac Studio", true(), "Unknown") | stats count as requests sum(completion_tokens) as generated_tokens sum(prompt_tokens) as prompt_tokens by accelerator key_alias | eval report_row=accelerator . " | " . key_alias . " | " . requests . " | " . generated_tokens . " | " . prompt_tokens | appendpipe [ stats count as request_rows | where request_rows == 0 | eval report_row="No requests in report window" | fields report_row ] | stats values(report_row) as report_rows | eval report="accelerator | caller | requests | generated tokens | prompt tokens; " . mvjoin(mvsort(report_rows), "; ") | table report
dispatch.earliest_time = -1d@d
dispatch.latest_time = @d
cron_schedule = 19 6 * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.suppress = 1
alert.suppress.period = 24h
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[gpu_real_work_weekly]
{{ report_delivery -}}
description = Weekly LiteLLM GPU usage by accelerator and caller, with request, generated-token and prompt-token totals.
search = index=llm sourcetype="litellm:proxy" | rex field=_raw "litellm\[\d+\]: (?<j>\{.*)" | spath input=j | fillnull value="unattributed" key_alias api_base | fillnull value=0 completion_tokens prompt_tokens | eval accelerator=case(match(api_base, "(?i)blackwell"), "RTX 6000", match(api_base, "(?i)ada-lovelace"), "RTX 4080", match(api_base, "(?i)mac"), "Mac Studio", true(), "Unknown") | stats count as requests sum(completion_tokens) as generated_tokens sum(prompt_tokens) as prompt_tokens by accelerator key_alias | eval report_row=accelerator . " | " . key_alias . " | " . requests . " | " . generated_tokens . " | " . prompt_tokens | appendpipe [ stats count as request_rows | where request_rows == 0 | eval report_row="No requests in report window" | fields report_row ] | stats values(report_row) as report_rows | eval report="accelerator | caller | requests | generated tokens | prompt tokens; " . mvjoin(mvsort(report_rows), "; ") | table report
dispatch.earliest_time = -7d@d
dispatch.latest_time = @d
cron_schedule = 39 6 * * 1
enableSched = 1
is_visible = 1
disabled = 0
alert.suppress = 1
alert.suppress.period = 7d
