{# ---------------------------------------------------------------------------
   Per-host silence detectors (os, hardware).

   One stanza per by_host splunk_docker_silence_detectors entry (see defaults
   for the field reference): tstats latest(_time) over the index BY HOST, fire
   when a host's own silence exceeds its cadence-derived threshold. Kept as
   its own stanza per detector rather than folded into index_gap_detector
   below because per-host cadence needs one row per host, which
   a single cross-index report cannot express — a healthy emitter can't mask
   a dead one. A detector with `expected_roster` compares against its lookup,
   so hosts with no events in the lookback still produce a row; other entries
   retain the observed-host behavior.

   Threshold is max(det.threshold_minutes, p95 gap between non-empty 10-minute
   bins times cadence_multiplier). Observed-only entries skip hosts below
   min_active_bins or above max_baseline_minutes; host_overrides pins a value.

   Grouped tstats returns zero rows for empty input. The expected-roster
   branch left-joins events; observed-host branches append an empty sentinel.
--------------------------------------------------------------------------- #}
{% from "savedsearches/00-silence-macros.j2" import host_gap_baseline, adaptive_host_threshold %}
{% for det in splunk_docker_silence_detectors | default([]) if det.by_host | default(false) %}
[{{ det.name }}_silence_detector]
{{ alert_delivery -}}
description = Alerts when {% if det.expected_roster | default(false) and splunk_docker_os_emitter_roster is defined %}an expected OS host has stopped sending to the OS event indexes{% else %}the {{ det.index }} index has received no events{% endif %} for more than {{ det.threshold_minutes }} minutes{% if det.sourcetype is defined %} (sourcetype={{ det.sourcetype }}){% endif %}{% if det.by_host | default(false) %}, detected per-host against each host's own cadence so a healthy emitter cannot mask a dead one{% endif %}. Catches the emitter, its Cribl pipeline, and Splunk HEC ingestion failing with a single signal.
{# The expected-roster branch preserves its lookup rows with a left join;
   observed-host branches use the appendpipe sentinel because grouped tstats
   returns no rows when its entire input is empty. #}
{% if det.expected_roster | default(false) and splunk_docker_os_emitter_roster is defined %}
{% set silence_search %}
| inputlookup {{ splunk_docker_os_emitter_roster.expected_lookup }}
| search host=*
| join type=left host [
    {{ host_gap_baseline('`' ~ splunk_docker_os_emitter_roster.indexes_macro ~ '`', det.sourcetype | default(none)) | replace('\n', ' ') | trim }}
]
| eval event_count=coalesce(event_count, 0), host_threshold_minutes=case({% for host, mins in (det.host_overrides | default({})) | dictsort %}host="{{ host }}", {{ mins }}, {% endfor %}true(), {{ adaptive_host_threshold('p95_gap_minutes', det.cadence_multiplier | default(splunk_docker_silence_cadence_multiplier | default(3)), det.threshold_minutes) }}), minutes_silent=(now()-coalesce(last_seen, 0))/60
| where minutes_silent > host_threshold_minutes
| eventstats values(host) as silent_hosts
| eval silent_hosts=mvjoin(mvsort(silent_hosts), ",")
{% endset %}
search = {{ silence_search | replace('\n', ' ') | trim }}
{% else %}
search = {{ host_gap_baseline('index=' ~ det.index, det.sourcetype | default(none)) | replace('\n', ' ') | trim }} | appendpipe [ stats count as _rows | where _rows == 0 | eval host = "(no hosts reporting)", last_seen = 0, event_count = 0 | fields - _rows ] | where coalesce(active_bins, {{ det.min_active_bins | default(3) }}) >= {{ det.min_active_bins | default(3) }}{% if det.max_baseline_minutes is defined %} AND coalesce(p95_gap_minutes, 0) <= {{ det.max_baseline_minutes }}{% endif %} | eval host_threshold_minutes = case({% for host, mins in (det.host_overrides | default({})) | dictsort %}host="{{ host }}", {{ mins }}, {% endfor %}true(), {{ adaptive_host_threshold('p95_gap_minutes', det.cadence_multiplier | default(splunk_docker_silence_cadence_multiplier | default(3)), det.threshold_minutes) }}) | eval minutes_silent = (now() - coalesce(last_seen, 0)) / 60 | where minutes_silent > host_threshold_minutes | eventstats values(host) as silent_hosts | eval silent_hosts = mvjoin(mvsort(silent_hosts), ",")
{% endif +%}
{# Keep `+`: with trim_blocks=True the next comment otherwise joins the search
   value. Template tests use the Ansible Jinja environment to check this. #}
# Lookback defaults to threshold_minutes x the multiplier. expected_roster
# preserves OS hosts beyond it; observed-only detectors remain window-bounded.
dispatch.earliest_time = -{{ det.lookback_minutes | default(det.threshold_minutes * splunk_docker_silence_lookback_multiplier) | int }}m
dispatch.latest_time = now
cron_schedule = {{ det.cron }}
enableSched = 1
is_visible = 1
disabled = {{ det.disabled | default(0) }}
alert.severity = 3
alert.suppress = 1
alert.suppress.period = {{ det.suppress_minutes }}m
{% if det.by_host | default(false) %}
# One notification per silent host, suppressed per host: each host pages once
# per suppress period. Keying a digest on the whole silent set re-paged every
# host whenever any one host joined or left the set. silent_hosts stays on
# every row so each notification still names the full set.
alert.digest_mode = 0
alert.suppress.fields = host
{% endif %}
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

{% endfor %}
{% if splunk_docker_os_emitter_roster is defined %}
[os_silence_roster_refresh]
description = Refreshes expected OS hosts from PVE inventory and recent OS event metadata.
{% set roster_search %}
| inputlookup {{ splunk_docker_os_emitter_roster.pve_lookup }}
| join type=left id [ | mstats latest(pve_up) as pve_up WHERE index=* by id ]
| where kind="node" OR isnull(pve_up) OR pve_up!=0
| fields host
| append [
    | tstats max(_indextime) as last_indexed WHERE `{{ splunk_docker_os_emitter_roster.indexes_macro }}` _index_earliest=-{{ splunk_docker_os_emitter_roster.observed_expiry_days }}d _index_latest=now by host
    | join type=left host [ | inputlookup {{ splunk_docker_os_emitter_roster.pve_lookup }} | eval in_pve_inventory=1 | fields host in_pve_inventory ]
    | where isnull(in_pve_inventory)
    | fields host
]
| dedup host
| appendpipe [ stats count as _rows | where _rows==0 | eval host="" | fields - _rows ]
| outputlookup createinapp=true {{ splunk_docker_os_emitter_roster.expected_lookup }}
{% endset %}
search = {{ roster_search | replace('\n', ' ') | trim }}
dispatch.earliest_time = -30d
dispatch.latest_time = now
cron_schedule = {{ splunk_docker_os_emitter_roster.refresh_cron }}
enableSched = 1
is_visible = 0
disabled = 0
alert.track = 0
{% endif %}

{% if splunk_docker_syslog_plane_down is defined %}
{% set syslog_plane = splunk_docker_syslog_plane_down %}
[syslog_plane_down]
{{ alert_delivery -}}
description = Alerts once when at least {{ syslog_plane.minimum_silent_hosts }} hosts that reported syslog in the previous {{ syslog_plane.reporting_window_minutes }} minutes have gone silent for {{ syslog_plane.silence_minutes }} minutes.
{% set plane_search %}
| tstats latest(_time) as last_seen WHERE index={{ syslog_plane.index }} sourcetype={{ syslog_plane.sourcetype }} by host
| eval reporting_start=relative_time(now(), "-{{ syslog_plane.reporting_window_minutes + syslog_plane.silence_minutes }}m"), silent_cutoff=relative_time(now(), "-{{ syslog_plane.silence_minutes }}m")
| where last_seen >= reporting_start AND last_seen <= silent_cutoff
| stats count as silent_host_count min(last_seen) as earliest_silent
| where silent_host_count >= {{ syslog_plane.minimum_silent_hosts }}
| eval earliest_silent=strftime(earliest_silent, "%Y-%m-%dT%H:%M:%SZ")
| table silent_host_count earliest_silent
{% endset %}
search = {{ plane_search | replace('\n', ' ') | trim }}
dispatch.earliest_time = -{{ syslog_plane.reporting_window_minutes + syslog_plane.silence_minutes }}m
dispatch.latest_time = now
cron_schedule = {{ syslog_plane.cron }}
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 5
alert.suppress = 1
alert.suppress.period = {{ syslog_plane.suppress_minutes }}m
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

{% endif %}

{# ---------------------------------------------------------------------------
   One gap detector, replacing the flat (non-by_host) per-index stanzas the
   loop above used to also emit. Thresholds stay declarative in
   splunk_docker_silence_detectors; this only changes how they render.

   INDEX TIME, NOT EVENT TIME. A sourcetype whose reported _time drifts
   ahead of the search head's clock (a bad sender clock, or a parse
   misconfiguration) makes any detector keyed on _time read a dead source as
   "very recently updated" and never fire -- exactly backwards. _indextime
   is Splunk's own receipt timestamp, set by the indexer at write time and
   immune to a sender's clock or parse config, so last_indexed below tracks
   when Splunk last WROTE a row for the index, not when the event claims to
   have happened. tstats aggregates _indextime the same way it aggregates
   _time -- both are default indexed metadata fields, not something a data
   model or acceleration is needed for.

   max(_indextime) selects the newest receipt independently of event _time.

   The append+stats max fills the same fully-empty-index blind spot the
   by_host loop above closes with appendpipe, but for a wildcarded search:
   tstats over index=* returns one row per index that has ANY event in the
   window, so an index with ZERO events in the whole window (never ingested,
   or dead longer than the window) has no row at all rather than a row with a
   stale last_indexed. Appending a synthetic last_indexed=0 row for every
   index this role declares and taking stats max(...) by index means a real
   tstats row wins where one exists (max picks the large real timestamp over
   the 0 sentinel) and the sentinel wins where none does -- age_min then
   comes out enormous, which is exactly "silent" for an index that has never
   said a word.

   Thresholds and exemptions come from the declarative lists above; missing
   thresholds default to 1440 minutes. Lookback covers the widest threshold.
--------------------------------------------------------------------------- #}
{% set flat_detectors = [] %}
{% for det in splunk_docker_silence_detectors | default([]) if not (det.by_host | default(false)) %}
{% set _ = flat_detectors.append(det) %}
{% endfor %}
{% for det in splunk_docker_silence_exemptions | default([]) if not (det.by_host | default(false)) %}
{% set _ = flat_detectors.append(det) %}
{% endfor %}
{% set gap_lookback_minutes = ((flat_detectors | map(attribute='threshold_minutes') | list + [1440]) | max) * splunk_docker_silence_lookback_multiplier %}
{# Each half defaults independently (never a combined-then-defaulted
   expression) so a caller that supplies neither -- every template test
   except the ones exercising this stanza specifically -- still renders,
   with an empty expected-index list rather than a Jinja UndefinedError. #}
{% set gap_expected_indexes = (splunk_docker_indexes | default((splunk_docker_indexes_core | default([])) + (splunk_docker_indexes_extra | default([])))) | map(attribute='name') | list %}
{% set exempt_detectors = [] %}
{% for det in flat_detectors if det.exempt | default(false) %}
{% set _ = exempt_detectors.append(det) %}
{% endfor %}
[index_gap_detector]
{{ alert_delivery -}}
description = Alerts when any index has gone silent longer than its configured threshold (default 1440 minutes), using the index's own last-write time rather than event time so a clock-skewed or unparsed sourcetype cannot hide behind a false "recently updated" reading. Replaces the flat per-index silence detectors with one report over every index this role creates. An index flagged exempt (see 11b-silence-exemptions.yml) never fires here regardless of age -- see [index_gap_exempt_report] below for the non-paging visibility into that exempt set.
search = | tstats max(_indextime) as last_indexed where index=* _index_earliest=-{{ gap_lookback_minutes }}m _index_latest=now by index | append [ | makeresults | eval index="{{ gap_expected_indexes | join(',') }}" | eval index=split(index, ",") | mvexpand index | eval last_indexed=0 ] | stats max(last_indexed) as last_indexed by index | eval age_min = round((now() - last_indexed) / 60) | eval threshold_minutes = case({% for det in flat_detectors %}index="{{ det.index }}", {{ det.threshold_minutes }}, {% endfor %}true(), 1440){% if exempt_detectors %} | eval exempt = if(in(index{% for det in exempt_detectors %}, "{{ det.index }}"{% endfor %}), 1, 0) | where exempt=0 AND age_min > threshold_minutes{% else %} | where age_min > threshold_minutes{% endif %}
dispatch.earliest_time = -{{ gap_lookback_minutes }}m
dispatch.latest_time = now
cron_schedule = */10 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 3
alert.suppress = 1
alert.suppress.period = 60m
# Scope suppression per index: without this, the first silent index
# suppresses the alert globally and a second index going silent inside the
# window goes unseen.
alert.suppress.fields = index
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

{% if exempt_detectors %}
[index_gap_exempt_report]
{{ status_delivery -}}
description = Daily, non-paging visibility into the index_gap_detector exemption list (11b-silence-exemptions.yml): every currently-exempt index with its reason, so an exemption never silently stands unnoticed. Not an alert on a fault -- a healthy run always returns one row per exempt index.
search = | makeresults | eval data="{% for det in exempt_detectors %}{{ det.index }}|{{ det.exempt_reason | replace('"', "'") }}|{{ det.review_by | default('') }};{% endfor %}" | eval row=split(data, ";") | mvexpand row | search row!="" | eval fields=split(row, "|") | eval index=mvindex(fields, 0), reason=mvindex(fields, 1), review_by=mvindex(fields, 2) | table index reason review_by
dispatch.earliest_time = -15m
dispatch.latest_time = now
cron_schedule = 0 8 * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 1
alert.suppress = 1
alert.suppress.period = 1440m
alert.track = 0
{% if splunk_docker_alert_ntfy_url %}
action.webhook.param.url = {{ splunk_docker_alert_ntfy_url }}?priority=low
{% endif %}
counttype = number of events
relation = greater than
quantity = 0
{% endif %}
