{# ---------------------------------------------------------------------------
   Hardware / disk-failure detectors (index=hardware).

   Content-match alerts over the hardware index fed by the Cribl exec packs
   (smartctl / zpool / ipmitool / nvme / megaraid) plus the syslog reclassify
   of smartd / kernel-disk / zed events out of index=os. Zero-noise by design:
   they match only real failure signatures, so they stay enabled and simply
   fire nothing until the hardware pipeline is converged and delivering. Tune
   the phrase lists once real events are flowing. Per-host suppression so one
   bad drive/host cannot mute alerts for another.
--------------------------------------------------------------------------- #}
[hardware_smart_failure]
{{ alert_delivery -}}
description = Fires on SMART failure signatures in the hardware index: a drive self-check FAILED, an attribute crossed into FAILING_NOW, pending / offline-uncorrectable sectors are present, or the raw value of a sector-health counter moved. These are the predictive signals that precede a disk dropping out of a pool (the bulk-pool case, 2026-07).
# The "<name> changed" phrases catch the raw-value tracking emitted for
# attributes 5 / 197 / 198. They are the counters that actually matter, and
# their NORMALIZED values sit at the ceiling long after the raw counts start
# climbing — so the standing "sectors" phrases below report a non-zero state
# while only these report the transition into it. A decrease matches too: that
# is a sector being reallocated, which is equally worth seeing.
# "Failed SMART usage Attribute" is the hard-fail wording emitted when a
# tracked counter is flagged critical.
search = index=hardware ("FAILING_NOW" OR "FAILED SMART self-check" OR "Failed SMART usage Attribute" OR "Reallocated_Sector_Ct changed" OR "Reallocated_Event_Count changed" OR "Current_Pending_Sector changed" OR "Offline_Uncorrectable changed" OR "Currently unreadable (pending) sectors" OR "Offline uncorrectable sectors")
dispatch.earliest_time = -20m
dispatch.latest_time = now
cron_schedule = */10 * * * *
enableSched = 1
is_visible = 1
# ponytail: matches ~563 times over 7 days, all on one cluster node
# (/dev/sdc, /dev/sdh) — genuine pending/uncorrectable sectors on a real
# failing disk, not a false alarm. Do NOT disable this thinking it's noise;
# per-host suppression (below) already throttles the actual notification
# rate well under the raw count.
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[hardware_zfs_fault]
{{ alert_delivery -}}
description = Fires when a ZFS vdev enters a non-healthy state (FAULTED / DEGRADED / UNAVAIL / REMOVED) via zed statechange events or the zpool exec pack. A raidz1/mirror losing a member drops to zero/reduced redundancy — the bulk-pool failure that started this workstream.
search = index=hardware ("vdev_state=FAULTED" OR "vdev_state=DEGRADED" OR "vdev_state=UNAVAIL" OR "vdev_state=REMOVED" OR "state: FAULTED" OR "state: DEGRADED" OR "state: UNAVAIL")
dispatch.earliest_time = -20m
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 5
alert.suppress = 1
alert.suppress.period = 60m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0

[hardware_ipmi_sel_critical]
{{ alert_delivery -}}
description = Fires on critical IPMI/BMC System Event Log entries (PSU / fan / thermal / voltage / drive-backplane faults) shipped by the ipmi exec pack from the bare-metal Dell hosts — hardware faults the OS never sees. Deasserted (recovery) events are excluded.
search = index=hardware sourcetype=ipmi:sel (Critical OR "Non-recoverable" OR Failure OR Asserted) NOT Deasserted
dispatch.earliest_time = -20m
dispatch.latest_time = now
cron_schedule = */10 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 60m
alert.suppress.fields = host
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
