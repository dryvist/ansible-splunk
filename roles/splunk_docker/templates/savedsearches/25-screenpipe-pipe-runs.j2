{# Per-run events come from the structured Screenpipe file source. #}
[screenpipe_pipe_run_failure]
{{ alert_delivery -}}
description = Alerts on a pipe timeout or the third consecutive unsuccessful run, grouped by pipe name.
search = index=llm sourcetype="screenpipe:pipe_run" "start" "end" "success" "error" | spath input=_raw | rex field=source "pipes/(?<pipe_name>[^/]+)/logs/" | where isnotnull(start) AND isnotnull(end) AND isnotnull(success) AND isnotnull(pipe_name) | eval failed=if(lower(tostring(success))="false" OR tostring(success)="0", 1, 0) | eval timed_out=if(match(lower(tostring(error)), "timeout|timed[_ -]?out"), 1, 0) | sort 0 pipe_name start | streamstats reset_after=(failed=0) sum(failed) as consecutive_failures by pipe_name | where (timed_out=1 OR consecutive_failures=3) AND _indextime >= relative_time(now(), "-5m") | table _time pipe_name start end success error
dispatch.earliest_time = -30d@d
dispatch.latest_time = now
cron_schedule = */5 * * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 4
alert.suppress = 1
alert.suppress.period = 5m
alert.suppress.fields = pipe_name
alert.track = 1
counttype = number of events
relation = greater than
quantity = 0
