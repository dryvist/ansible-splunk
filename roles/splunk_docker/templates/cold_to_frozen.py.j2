#!/usr/bin/env python3
# {{ ansible_managed }}
#
# Splunk coldToFrozenScript: archive a bucket to S3-compatible object storage
# before Splunk removes it.
#
# CONTRACT WITH SPLUNK
#   argv[1] is the bucket directory. Exiting 0 tells Splunk the bucket is safe
#   to delete, so this script must not return 0 until every file is durably
#   stored. Any failure exits non-zero, which leaves the bucket in place on
#   disk. That is the safe direction: a stuck bucket costs space, a false
#   success costs the data.
#
# WHY RCLONE RATHER THAN OUR OWN S3 CLIENT
#   This used to sign, stream, and retry S3 requests by hand. That code was
#   correct and still lost: it uploaded one file at a time over one connection,
#   and the offsite endpoint throttles per connection, so archiving ran slower
#   than data arrived. Measured there: 318 KB/s on a single connection against
#   1.64 MB/s across eight. Fixing it properly means multipart uploads with
#   parallel parts - a substantial amount of protocol code to own and test.
#
#   rclone already does that, plus retry, integrity verification, and a native
#   B2 backend if the archive ever moves off the S3 API. It ships as a single
#   static binary installed into the config volume, which is bind-mounted into
#   this container - so nothing is added to the vendor image and nothing breaks
#   on the next image bump. Avoiding a dependency in the image was the original
#   reason for hand-rolling; a static binary in a mounted volume answers that
#   without owning the protocol.
#
# WHY PER-FILE UPLOAD RATHER THAN A TARBALL
#   Freezing happens precisely when a volume is under pressure. Building a
#   tarball first would need room for a second copy of the bucket at the moment
#   there is least room to spare. Copying the directory streams straight from
#   disk and needs no scratch space.

import os
import subprocess
import sys

CONFIG_PATH = "{{ splunk_docker_frozen_config_path }}"
RCLONE = "{{ splunk_docker_frozen_rclone_path }}"

# Concurrency, both across files and across the parts of one file. The endpoint
# throttles per connection, so this is the setting that governs throughput.
# Lower it for an on-network target, where one connection is already fast and
# extra connections only add contention.
TRANSFERS = {{ splunk_docker_frozen_upload_concurrency | int }}

# Below this a file is sent whole; above it rclone splits it into concurrent
# parts. Bucket files run to hundreds of MB, which is the case single-stream
# upload handled worst.
UPLOAD_CUTOFF = "64M"

# Stall tolerance for one transfer, not a budget for the whole object. A value
# tuned to how long a bucket "should" take is what previously failed every
# large bucket and left it on disk forever.
TIMEOUT = "{{ splunk_docker_frozen_upload_timeout_seconds | int }}s"

ARCHIVE_MARKER_NAME = "_ARCHIVE_COMPLETE"

REMOTE = "archive"


def _read_config_file(path):
    """Parse simple KEY=value lines. Blank lines and '#' comments are ignored.

    Deliberately not INI/JSON - the config has no nesting, so the simplest
    parser that works is the right one.
    """
    values = {}
    try:
        with open(path, "r") as fh:
            lines = fh.readlines()
    except OSError:
        return values
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip()
    return values


_FILE_CONFIG = _read_config_file(CONFIG_PATH)


def _setting(name, default=""):
    """Environment first, then the config file.

    splunkd invokes this with a restricted environment, so the compose-injected
    variables are invisible on the path that actually matters - the config file
    is what makes real evictions work. The environment stays checked first so a
    manual `docker exec` canary run keeps behaving the same way.
    """
    value = os.environ.get(name, "")
    if value:
        return value
    return _FILE_CONFIG.get(name, default)


ENDPOINT = _setting("SPLUNK_FROZEN_S3_ENDPOINT")
BUCKET = _setting("SPLUNK_FROZEN_S3_BUCKET")
KEY_ID = _setting("SPLUNK_FROZEN_S3_KEY_ID")
APP_KEY = _setting("SPLUNK_FROZEN_S3_APP_KEY")
# Optional. Endpoints that encode their region in the hostname need nothing
# here, and rclone signs with whatever it is given.
REGION = _setting("SPLUNK_FROZEN_S3_REGION")


def log(msg):
    """Write to stderr.

    splunkd captures this script's stderr into splunkd.log, so it is where an
    operator will actually look when a freeze goes wrong.
    """
    sys.stderr.write("cold_to_frozen: %s\n" % msg)
    sys.stderr.flush()


def rclone_env():
    """Configure the remote entirely through the environment.

    rclone reads RCLONE_CONFIG_<REMOTE>_<OPTION>, so there is no config file to
    write, no credential on any command line, and nothing left on disk beyond
    the credential file the role already manages.
    """
    env = dict(os.environ)
    prefix = "RCLONE_CONFIG_%s_" % REMOTE.upper()
    env.update(
        {
            prefix + "TYPE": "s3",
            prefix + "PROVIDER": "Other",
            prefix + "ENDPOINT": ENDPOINT,
            prefix + "ACCESS_KEY_ID": KEY_ID,
            prefix + "SECRET_ACCESS_KEY": APP_KEY,
            prefix + "REGION": REGION,
        }
    )
    return env


def run_rclone(args, stdin_data=None):
    """Run rclone. Returns None on success or an error string."""
    cmd = [
        RCLONE,
        # Refuse to read or create an on-disk rclone config. Everything comes
        # from the environment above, so a stray config file must not be able
        # to redirect the archive somewhere else.
        "--config",
        os.devnull,
        "--timeout",
        TIMEOUT,
        "--transfers",
        str(TRANSFERS),
        "--s3-upload-concurrency",
        str(TRANSFERS),
        "--s3-upload-cutoff",
        UPLOAD_CUTOFF,
        "--s3-chunk-size",
        UPLOAD_CUTOFF,
        # Never probe for or create the destination bucket. rclone's default is
        # to ensure it exists before writing, which needs a create permission
        # the archive credential deliberately does not have — it is scoped to
        # one existing bucket. The endpoint answers that probe with a 403 and
        # rclone treats it as fatal, so every upload failed before a single
        # byte moved. The bucket is created out of band; this only ever writes
        # into it.
        "--s3-no-check-bucket",
        "--bwlimit",
        "{{ splunk_docker_frozen_bwlimit }}",
        "--retries",
        "5",
        "--stats",
        "0",
    ] + args
    try:
        result = subprocess.run(
            cmd,
            env=rclone_env(),
            input=stdin_data,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as exc:
        return "cannot run rclone at %s: %s" % (RCLONE, exc)
    if result.returncode != 0:
        # rclone names the failing object and reason. Only the last line is
        # kept: the full trace is long and adds nothing splunkd.log needs.
        detail = (result.stderr or b"").decode("utf-8", "replace").strip()
        last = detail.splitlines()[-1] if detail else "no detail"
        return "rclone exited %d: %s" % (result.returncode, last)
    return None


def main():
    if len(sys.argv) < 2:
        log("no bucket path given")
        return 1
    bucket_dir = sys.argv[1].rstrip("/")

    if not os.path.isdir(bucket_dir):
        log("not a directory: %s" % bucket_dir)
        return 1

    missing = [
        name
        for name, value in (
            ("endpoint", ENDPOINT),
            ("bucket", BUCKET),
            ("key id", KEY_ID),
            ("app key", APP_KEY),
        )
        if not value
    ]
    if missing:
        # Refusing here is the point: without credentials the only alternative
        # is to let Splunk delete the bucket unarchived.
        log("refusing to freeze, missing config: %s" % ", ".join(missing))
        return 1

    # Splunk lays buckets out as <index>/<state>db/<bucket>, so the index name
    # is recoverable from the path and keeps archived objects grouped per index.
    parts = bucket_dir.split(os.sep)
    bucket_name = parts[-1]
    index_name = parts[-3] if len(parts) >= 3 else "unknown"

    files = []
    for root, _dirs, filenames in os.walk(bucket_dir):
        for filename in filenames:
            files.append(os.path.join(root, filename))

    if not files:
        log("no files under %s, refusing to report success" % bucket_dir)
        return 1

    log("archiving %s (%d files) from index %s" % (bucket_name, len(files), index_name))

    prefix = "%s:%s/%s/%s" % (REMOTE, BUCKET, index_name, bucket_name)
    err = run_rclone(["copy", bucket_dir, prefix])
    if err:
        log("FAILED: %s - bucket left on disk for retry" % err)
        return 1

    # The completion marker: written last, and only once every file succeeded.
    #
    # An interrupted freeze leaves a partial prefix that looks exactly like an
    # archived bucket from a LIST - the store already holds one such
    # half-uploaded bucket from before this path worked. Parallel transfers make
    # that more likely, not less: files land out of order, so even the last key
    # by name proves nothing. Restore must treat any bucket without this marker
    # as incomplete rather than trusting object presence.
    manifest = "".join(
        "%s %d\n" % (os.path.relpath(path, bucket_dir), os.path.getsize(path))
        for path in sorted(files)
    )
    body = ("files=%d\n%s" % (len(files), manifest)).encode("utf-8")
    err = run_rclone(["rcat", "%s/%s" % (prefix, ARCHIVE_MARKER_NAME)], stdin_data=body)
    if err:
        # Every file is stored but the bucket is not yet provably complete.
        # Exiting non-zero keeps it on disk, which costs space and re-uploads
        # next pass - the cheap direction. Reporting success here would leave a
        # bucket restore cannot verify.
        log("FAILED: %s - marker not written, bucket left on disk" % err)
        return 1

    log("archived %s (%d files)" % (bucket_name, len(files)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
