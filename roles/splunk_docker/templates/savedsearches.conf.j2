{% if splunk_docker_alert_two_tiers_enabled | default(true) %}

{# Non-critical alerts above trigger and are tracked but page nowhere; this
   is their delivery. One run every 12 hours reads the window's fired-alert
   audit records, leaves out the paging (severity >= threshold) stanzas the
   alert_delivery macro collected above, and posts one status-topic message
   listing each rule that fired with its fire count, most frequent first,
   capped at 40 lines. Zero rows -> no trigger -> no message. digest_mode
   keeps every result row in that one message; track stays off so the digest
   never lists itself. #}
[alert_digest_12h]
{{ status_delivery -}}
description = Every 12 hours, one non-paging summary of every non-critical saved search that fired in the window: one line per rule with its fire count, most frequent first, capped at 40 rules. Paging (severity >= splunk_docker_alert_page_min_severity) rules are excluded -- they notify directly. Sends nothing when no tracked rule fired.
search = index=_audit action=alert_fired ss_app=homelab_alerts{% for n in critical_stanzas.names | sort %} ss_name!="{{ n }}"{% endfor %} | stats count as fires by ss_name | sort -fires | head 40
dispatch.earliest_time = -12h
dispatch.latest_time = now
cron_schedule = 17 5,17 * * *
enableSched = 1
is_visible = 1
disabled = 0
alert.severity = 1
alert.suppress = 1
alert.suppress.period = 12h
alert.digest_mode = 1
alert.track = 0
counttype = number of events
relation = greater than
quantity = 0
{%- endif %}
