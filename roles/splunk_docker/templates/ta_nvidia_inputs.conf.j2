# The Splunk server has no GPU: it keeps the TA's dashboards and parsing but
# never runs nvidia-smi. A GPU host that installs this app re-enables them.
[script://./bin/nvidia_smi_events.py]
index = nvidia
interval = 60
disabled = 1

[script://./bin/nvidia_smi_metrics.py]
index = nvidia_metrics
interval = 60
disabled = 1
