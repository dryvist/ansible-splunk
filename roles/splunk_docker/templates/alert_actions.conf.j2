{{ ansible_managed | comment }}
{# Alert-action plumbing for the ntfy hub webhook, the only delivery used by
   saved searches in savedsearches.conf.j2. #}
{% if splunk_docker_alert_ntfy_url %}
[webhook]
# Splunk 9+ gates the webhook alert action behind an allowlist; without this
# the ntfy action fails silently. Anchor the topic URL, allow the per-alert
# ?title/&priority query suffix.
enable_allowlist = true
allowlist.ntfy = ^{{ splunk_docker_alert_ntfy_url | regex_escape }}(\?.*)?$
# The network topic on the same hub (savedsearches/19-unifi-wan.j2).
allowlist.ntfy_network = ^{{ (splunk_docker_alert_ntfy_url.rsplit('/', 1)[0] ~ '/network') | regex_escape }}(\?.*)?$
{% endif %}
